# sepolicy.rule
#
# This file allows you to add custom SELinux policy rules.
# Each line is treated as a policy statement.
#
# KernelSU loads these rules during the post-fs-data stage.
#
# ---------------------------------------------------------------------------------------
# SYNTAX
# ---------------------------------------------------------------------------------------
# The syntax generally follows the standard magiskpolicy/supolicy format:
# allow <source_class> <target_class> <class> <permission>
# create <class> <name>
# attradd <class> <attribute>
#
# ---------------------------------------------------------------------------------------
# EXAMPLES
# ---------------------------------------------------------------------------------------
#
# Allow a specific app (untrusted_app) to read a specific device file:
# allow untrusted_app my_device_device chr_file { read write open ioctl }
#
# Allow system_server to access a custom service:
# allow system_server my_custom_service service_manager find
#
# Grant permissive to a specific domain (use with caution!):
# permissive my_custom_domain
#
# ---------------------------------------------------------------------------------------

# Add your custom rules below:

# Termux API socket 访问豁免
allow untrusted_app_27 app_data_file:unix_stream_socket connectto
allow untrusted_app_27 shell_data_file:unix_stream_socket connectto
allow untrusted_app_27 termux_api_socket:unix_stream_socket connectto
allow termux_api app_data_file:unix_stream_socket connectto

# Android 15 额外权限
allow untrusted_app_27 termux_api_socket:sock_file { read write create unlink setattr }
allow untrusted_app_27 app_data_file:sock_file { read write create unlink setattr }
allow untrusted_app_27 shell_data_file:sock_file { read write create unlink setattr }
allow untrusted_app_27 tmpfs:sock_file { read write create unlink setattr }

# 允许访问本地 socket 目录
allow untrusted_app_27 tmpfs:dir { search write add_name remove_name }
allow untrusted_app_27 app_data_file:dir { search write add_name remove_name }
allow untrusted_app_27 shell_data_file:dir { search write add_name remove_name }

# 允许 termux:API 访问系统资源
allow termux_api system_file:dir { search read }
allow termux_api system_file:file { read open }
allow termux_api zygote_exec:file { read execute }

# 允许进程间通信
allow untrusted_app_27 termux_api:unix_stream_socket { read write connectto }
allow termux_api untrusted_app_27:unix_stream_socket { read write accept }
