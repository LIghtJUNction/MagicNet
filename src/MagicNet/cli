}

cli_health_cert_count() {
    _dir="$(cli_cert_dir)"
    _count=0
    if [ -d "$_dir" ]; then
        for _cert in "$_dir"/*; do
            [ -f "$_cert" ] || continue
            [ "${_cert##*/}" = ".gitkeep" ] && continue
            _count=$((_count + 1))
        done
    fi
    printf '%s\n' "$_count"
