# shellcheck shell=ash

export HOME=${MODDIR}
export KAM_HOME=${KAM_HOME:-${MODDIR}}
export KAMFW_DIR=${MODDIR}/lib/kamfw
# The module registry is shell-local. Child processes inherit names but not
# shell functions, so retaining an exported value makes imports disappear.
unset KAM_MODULES
KAM_MODULES=""
# Installation managers can remove a failed `modules_update` tree before
# kamfw's EXIT handlers finish. Keep framework logs in the persistent module
# cache so failure reporting never targets that disposable path.
export KAM_LOGFILE=${KAM_LOGFILE:-${MAGICNET_CACHE_DIR:-/data/adb/cache/MagicNet}/kam.log}
export MAGIC_SINGBOX="${MAGIC_SINGBOX:-1}"
