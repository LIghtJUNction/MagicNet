# Packages that bypass MagicNet TUN when MAGICNET_APP_MODE=blacklist.
# One package name per line.
#
# Critical domestic apps (WeChat/QQ/Alipay/banks/etc.) should exit TUN so their
# in-app WebView / payment H5 does not follow proxy/block routes and appear offline.
# Managed critical seed is also re-ensured at apply time if missing.

# Chat / office
com.tencent.mm
com.tencent.mobileqq
com.tencent.tim
com.tencent.wework
com.alibaba.android.rimet

# Payments / banks
com.eg.android.AlipayGphone
com.unionpay
com.unionpay.tsmservice
com.icbc
com.chinamworld.main
com.cmbchina.ccd.pluto.cmbActivity
com.cmbchina.cmbim
com.bankcomm.Bankcomm
cn.com.spdb.mobilebank.per

# Domestic shopping, local services, travel, and rail apps.
com.taobao.idlefish
com.taobao.taobao
com.xunmeng.pinduoduo
com.sankuai.meituan
ctrip.android.view
com.MobileTicket

# Other VPN / tunnel clients (avoid multi-TUN fights)
