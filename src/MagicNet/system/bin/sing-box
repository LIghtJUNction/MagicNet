#!/system/bin/sh

case "$0" in
  */system/bin/sing-box) MODDIR=${MODDIR:-${0%/system/bin/sing-box}} ;;
  */*) MODDIR=${MODDIR:-${0%/*}/../..} ;;
  *) MODDIR=${MODDIR:-/data/adb/modules/MagicNet} ;;
esac

export HOME="$MODDIR"
export PATH="$MODDIR/.local/bin:$PATH"
export LD_LIBRARY_PATH="$MODDIR/.local/lib:$MODDIR/lib:${LD_LIBRARY_PATH:-}"

if [ -x "$MODDIR/.local/bin/sing-box" ]; then
  exec "$MODDIR/.local/bin/sing-box" "$@"
else
  echo "sing-box: executable not found at $MODDIR/.local/bin/sing-box" >&2
  exit 127
fi
